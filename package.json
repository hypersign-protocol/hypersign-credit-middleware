{
  "name": "@hypersign-protocol/credit-middleware",
  "version": "2.0.0",
  "description": "NestJS Redis-backed credit reservation SDK for metered API services",
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "nestjs",
    "credits",
    "metering",
    "rate-limiting",
    "redis",
    "reservation",
    "interceptor",
    "billing"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:example": "tsc -p example/tsconfig.json",
    "start:example": "npm run build:example && node dist-example/example/main.js",
    "start:example:multi": "npm run build:example && node dist-example/example/multi-module/main.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <12",
    "@nestjs/core": ">=10 <12",
    "rxjs": ">=7 <8"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "6.1.3",
    "@types/jest": "^30.0.0",
    "ioredis": "^5.7.0",
    "jest": "^30.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
